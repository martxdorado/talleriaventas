---
const navLinks = [
  { label: 'Inicio', href: '#hero' },
  { label: 'Sobre mí', href: '#about' },
  { label: 'Branding', href: '#branding' },
  { label: 'Personajes', href: '#character-design' },
  { label: 'Portfolio', href: '#portfolio' },
  { label: 'Servicios', href: '#services' },
  { label: 'Contacto', href: '#contact' },
];
---

<!-- Desktop Sidebar & Mobile Top bar -->
<div class="md:contents">
  <!-- Mobile Top Bar -->
  <div class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between p-4 bg-bg-base/80 backdrop-blur-xl border-b border-border-subtle md:hidden">
    <a href="#hero" class="flex items-baseline gap-1">
      <span class="font-heading text-xl font-bold tracking-tight text-text-primary">
        mrt<span class="text-neon-pink">x</span>
      </span>
      <span class="text-xs text-text-muted font-heading tracking-wide">studio</span>
    </a>

    <!-- Hamburger -->
    <button
      id="hamburger"
      class="relative flex flex-col justify-center items-center w-10 h-10 gap-1.5 group cursor-pointer"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <span class="hamburger-line block w-6 h-0.5 bg-text-primary transition-all duration-300 origin-center"></span>
      <span class="hamburger-line block w-6 h-0.5 bg-text-primary transition-all duration-300 origin-center"></span>
      <span class="hamburger-line block w-6 h-0.5 bg-text-primary transition-all duration-300 origin-center"></span>
    </button>
  </div>

  <!-- Desktop Sidebar Navigation -->
  <aside
    id="sidebar"
    class="fixed top-0 left-0 bottom-0 z-40 w-64 bg-bg-surface/50 backdrop-blur-xl border-r border-border-subtle p-8 hidden md:flex flex-col justify-between"
  >
    <!-- Brand / Logo -->
    <div class="flex flex-col gap-1">
      <a href="#hero" class="flex items-baseline gap-1 group">
        <span class="font-heading text-2xl font-bold tracking-tight text-text-primary">
          mrt<span class="text-neon-pink">x</span>
        </span>
        <span class="text-sm text-text-muted font-heading tracking-wide">studio</span>
      </a>
      <span class="text-[10px] text-text-muted/60 uppercase tracking-[0.2em] font-heading mt-1">Diseño Multidisciplinar</span>
    </div>

    <!-- Navigation List -->
    <nav class="my-auto">
      <ul class="flex flex-col gap-6">
        {navLinks.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class="nav-link relative block py-1 text-sm text-text-muted hover:text-neon-blue transition-colors duration-300 tracking-wider uppercase font-heading font-medium"
              data-section={href.slice(1)}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Sidebar Footer -->
    <div class="flex flex-col gap-2">
      <span class="text-[10px] text-text-muted/40 uppercase tracking-widest font-heading font-light">© 2026 mrtx studio</span>
    </div>
  </aside>

  <!-- Mobile Overlay Menu -->
  <div
    id="mobile-menu"
    class="mobile-menu fixed inset-0 z-40 bg-bg-base/95 backdrop-blur-2xl flex flex-col items-center justify-center opacity-0 pointer-events-none transition-all duration-500"
  >
    <ul class="flex flex-col items-center gap-8">
      {navLinks.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class="mobile-nav-link text-2xl font-heading font-semibold text-text-muted hover:text-neon-blue transition-colors duration-300 tracking-wide uppercase"
            data-section={href.slice(1)}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  /* Mobile menu open state */
  .mobile-menu.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Hamburger X animation */
  #hamburger.is-active .hamburger-line:nth-child(1) {
    transform: translateY(4.5px) rotate(45deg);
  }
  #hamburger.is-active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger.is-active .hamburger-line:nth-child(3) {
    transform: translateY(-4.5px) rotate(-45deg);
  }

  /* Active nav link */
  .nav-link.is-active,
  .mobile-nav-link.is-active {
    color: var(--color-neon-blue);
    text-shadow: 0 0 10px rgba(0, 210, 255, 0.4);
  }

  .nav-link {
    transition: color 200ms var(--ease-out-premium), transform 160ms var(--ease-out-premium);
  }
  .nav-link:active {
    transform: scale(0.96);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const hamburger = document.getElementById('hamburger');
    const mobileMenu = document.getElementById('mobile-menu');
    const navLinks = document.querySelectorAll('.nav-link');
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
    const allLinks = [...navLinks, ...mobileNavLinks];

    // --- Hamburger Toggle ---
    hamburger?.addEventListener('click', () => {
      const isOpen = hamburger.classList.toggle('is-active');
      mobileMenu?.classList.toggle('is-open');
      hamburger.setAttribute('aria-expanded', String(isOpen));
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });

    // Close mobile menu on link click
    mobileNavLinks.forEach((link) => {
      link.addEventListener('click', () => {
        hamburger?.classList.remove('is-active');
        mobileMenu?.classList.remove('is-open');
        hamburger?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      });
    });

    // --- Active Link on Scroll (IntersectionObserver) ---
    const sections = document.querySelectorAll('section[id]');

    const observerOptions = {
      root: null,
      rootMargin: '-20% 0px -60% 0px',
      threshold: 0,
    };

    const setActiveLink = (sectionId: string) => {
      allLinks.forEach((link) => {
        const linkSection = link.getAttribute('data-section');
        if (linkSection === sectionId) {
          link.classList.add('is-active');
        } else {
          link.classList.remove('is-active');
        }
      });
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          setActiveLink(entry.target.id);
        }
      });
    }, observerOptions);

    sections.forEach((section) => observer.observe(section));
  });
</script>
