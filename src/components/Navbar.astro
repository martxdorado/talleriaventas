---
const navLinks = [
  { label: 'Inicio', href: '#hero' },
  { label: 'Sobre mí', href: '#about' },
  { label: 'Branding', href: '#branding' },
  { label: 'Personajes', href: '#character-design' },
  { label: 'Portfolio', href: '#portfolio' },
  { label: 'Servicios', href: '#services' },
  { label: 'Contacto', href: '#contact' },
];
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 bg-bg-base/80 backdrop-blur-xl border-b border-border-subtle transition-all duration-300"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between py-8 px-12">
    <!-- Logo -->
    <a href="#hero" class="flex items-baseline gap-1 group">
      <span class="font-heading text-2xl font-bold tracking-tight text-text-primary">
        mrt<span class="text-neon-pink">x</span>
      </span>
      <span class="text-sm text-text-muted font-heading tracking-wide">studio</span>
    </a>

    <!-- Desktop Navigation -->
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class="nav-link text-sm text-text-muted hover:text-neon-blue transition-colors duration-300 tracking-wide uppercase font-heading font-medium"
            data-section={href.slice(1)}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile Hamburger -->
    <button
      id="hamburger"
      class="md:hidden relative z-60 flex flex-col justify-center items-center w-10 h-10 gap-1.5 group cursor-pointer"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <span class="hamburger-line block w-6 h-0.5 bg-text-primary transition-all duration-300 origin-center"></span>
      <span class="hamburger-line block w-6 h-0.5 bg-text-primary transition-all duration-300 origin-center"></span>
      <span class="hamburger-line block w-6 h-0.5 bg-text-primary transition-all duration-300 origin-center"></span>
    </button>
  </div>

  <!-- Mobile Overlay Menu -->
  <div
    id="mobile-menu"
    class="mobile-menu fixed inset-0 z-50 bg-bg-base/95 backdrop-blur-2xl flex flex-col items-center justify-center opacity-0 pointer-events-none transition-all duration-500"
  >
    <ul class="flex flex-col items-center gap-8">
      {navLinks.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class="mobile-nav-link text-2xl font-heading font-semibold text-text-muted hover:text-neon-blue transition-colors duration-300 tracking-wide uppercase"
            data-section={href.slice(1)}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  /* Mobile menu open state */
  .mobile-menu.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Hamburger X animation */
  #hamburger.is-active .hamburger-line:nth-child(1) {
    transform: translateY(4.5px) rotate(45deg);
  }
  #hamburger.is-active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger.is-active .hamburger-line:nth-child(3) {
    transform: translateY(-4.5px) rotate(-45deg);
  }

  /* Active nav link */
  .nav-link.is-active,
  .mobile-nav-link.is-active {
    color: var(--color-neon-blue);
    text-shadow: 0 0 10px rgba(0, 210, 255, 0.4);
  }

  /* Scrolled navbar */
  #navbar.scrolled {
    background-color: rgba(255, 255, 255, 0.95);
    border-bottom-color: rgba(255, 0, 127, 0.08);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const navbar = document.getElementById('navbar');
    const hamburger = document.getElementById('hamburger');
    const mobileMenu = document.getElementById('mobile-menu');
    const navLinks = document.querySelectorAll('.nav-link');
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
    const allLinks = [...navLinks, ...mobileNavLinks];

    // --- Hamburger Toggle ---
    hamburger?.addEventListener('click', () => {
      const isOpen = hamburger.classList.toggle('is-active');
      mobileMenu?.classList.toggle('is-open');
      hamburger.setAttribute('aria-expanded', String(isOpen));
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });

    // Close mobile menu on link click
    mobileNavLinks.forEach((link) => {
      link.addEventListener('click', () => {
        hamburger?.classList.remove('is-active');
        mobileMenu?.classList.remove('is-open');
        hamburger?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      });
    });

    // --- Navbar Scroll Opacity ---
    const handleScroll = () => {
      if (window.scrollY > 50) {
        navbar?.classList.add('scrolled');
      } else {
        navbar?.classList.remove('scrolled');
      }
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // --- Active Link on Scroll (IntersectionObserver) ---
    const sections = document.querySelectorAll('section[id]');

    const observerOptions = {
      root: null,
      rootMargin: '-20% 0px -60% 0px',
      threshold: 0,
    };

    const setActiveLink = (sectionId: string) => {
      allLinks.forEach((link) => {
        const linkSection = link.getAttribute('data-section');
        if (linkSection === sectionId) {
          link.classList.add('is-active');
        } else {
          link.classList.remove('is-active');
        }
      });
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          setActiveLink(entry.target.id);
        }
      });
    }, observerOptions);

    sections.forEach((section) => observer.observe(section));
  });
</script>
