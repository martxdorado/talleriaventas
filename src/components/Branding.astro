---
---

<section id="branding" class="section-padding relative overflow-hidden bg-bg-surface">
  <!-- Organic background shapes -->
  <div class="pointer-events-none absolute inset-0 opacity-5" aria-hidden="true">
    <svg class="absolute top-10 -right-24 w-[500px] h-[500px] text-neon-yellow animate-float" viewBox="0 0 100 100" fill="currentColor">
      <path d="M42.7,-60.1C55.3,-52.3,65.5,-39.8,70.9,-25.2C76.3,-10.7,76.9,5.8,73.4,21.5C69.9,37.2,62.3,52,50.1,62.4C37.8,72.9,20.9,78.9,4.4,72.8Z" transform="translate(50,50)" />
    </svg>
  </div>

  <div class="section-container relative z-10">
    <!-- Header -->
    <div class="mb-16 reveal">
      <span class="text-xs font-heading uppercase tracking-[0.3em] text-neon-yellow font-medium">Servicios Especializados</span>
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-text-primary mt-2">Identidad de Marca & Branding</h2>
      <div class="mt-4 h-0.5 w-16 bg-neon-yellow"></div>
    </div>

    <!-- Presentation Grid -->
    <div class="grid items-center gap-12 md:grid-cols-2">
      <!-- Info Left -->
      <div class="reveal reveal-delay-1 flex flex-col gap-6">
        <h3 class="font-heading text-2xl font-semibold text-neon-yellow">Construyendo marcas memorables</h3>
        <p class="text-lg leading-relaxed text-text-primary">
          En <span class="text-neon-pink font-semibold">mrtx studio</span> no solo creamos logotipos; conceptualizamos la personalidad visual completa de tu proyecto. 
        </p>
        <p class="leading-relaxed text-text-muted">
          Diseñamos sistemas de identidad coherentes que abarcan desde la paleta de colores, tipografía corporativa y voz de marca, hasta la papelería física y presencia en canales digitales. Todo pensado para marcar la diferencia en un mercado sobresaturado.
        </p>
        
        <!-- Key Points -->
        <div class="mt-4 grid grid-cols-2 gap-4">
          <div class="p-4 rounded-xl bg-bg-elevated border border-border-subtle hover:border-neon-yellow transition duration-300">
            <span class="block text-2xl font-bold text-neon-pink mb-1">01</span>
            <span class="text-xs font-heading uppercase tracking-wider text-text-primary">Estrategia Visual</span>
          </div>
          <div class="p-4 rounded-xl bg-bg-elevated border border-border-subtle hover:border-neon-yellow transition duration-300">
            <span class="block text-2xl font-bold text-neon-blue mb-1">02</span>
            <span class="text-xs font-heading uppercase tracking-wider text-text-primary">Diseño de Logotipos</span>
          </div>
          <div class="p-4 rounded-xl bg-bg-elevated border border-border-subtle hover:border-neon-yellow transition duration-300">
            <span class="block text-2xl font-bold text-neon-yellow mb-1">03</span>
            <span class="text-xs font-heading uppercase tracking-wider text-text-primary">Brand Guidelines</span>
          </div>
          <div class="p-4 rounded-xl bg-bg-elevated border border-border-subtle hover:border-neon-yellow transition duration-300">
            <span class="block text-2xl font-bold text-text-primary mb-1">04</span>
            <span class="text-xs font-heading uppercase tracking-wider text-text-primary">Papelería Premium</span>
          </div>
        </div>
      </div>

      <!-- Preview Image Right -->
      <div class="reveal reveal-delay-2">
        <div class="group relative overflow-hidden rounded-2xl neon-border shadow-lg">
          <div class="absolute -inset-0.5 rounded-2xl bg-neon-yellow/20 opacity-0 blur-sm transition-opacity duration-500 group-hover:opacity-100"></div>
          <img
            src="/images/branding.png"
            alt="Branding mockups by mrtx studio"
            class="relative w-full rounded-2xl object-cover aspect-[4/3] transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>
