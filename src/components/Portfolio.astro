---
const filters = ['Todos', 'Revistas', 'Libros', 'Catálogos', 'Branding', 'Personajes'];

const projects = [
  {
    title: 'Espacio Interior',
    category: 'Revistas',
    image: '/images/espacio-interior.png',
    description: 'Revista de arquitectura y diseño de interiores. 120 páginas de elegancia visual.',
  },
  {
    title: 'Raíces Urbanas',
    category: 'Libros',
    image: '/images/raices-urbanas.png',
    description: 'Ensayo fotográfico sobre la transformación de las ciudades contemporáneas.',
  },
  {
    title: 'Neo-Identidad Corporativa',
    category: 'Branding',
    image: '/images/branding.png',
    description: 'Manual de identidad visual y papelería corporativa con estética neón minimalista.',
  },
  {
    title: 'Cyberpunk Vector Character',
    category: 'Personajes',
    image: '/images/character.png',
    description: 'Ilustración y diseño de personaje vectorial futurista con líneas de neón definidas.',
  },
  {
    title: 'Colección Otoño',
    category: 'Catálogos',
    image: '/images/coleccion-otono.png',
    description: 'Catálogo de moda con tipografía experimental y dirección de arte integral.',
  },
  {
    title: 'Gastronomía Nómada',
    category: 'Revistas',
    image: '/images/gastronomia-nomada.png',
    description: 'Revista gastronómica trimestral con fotografía editorial de autor.',
  },
];
---

<section id="portfolio" class="section-padding bg-bg-surface relative overflow-hidden">
  <!-- Decorative organic shapes -->
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
    <svg class="absolute -bottom-24 -right-24 w-96 h-96 text-neon-blue animate-float" viewBox="0 0 100 100" fill="currentColor">
      <path d="M47.7,-63.2C60.9,-54.6,70.1,-38.7,73.6,-22.1C77.1,-5.5,74.9,11.8,68,27.2C61.1,42.5,49.5,55.9,35,63.7C20.6,71.5,3.3,73.6,-14.7,70.8Z" transform="translate(50,50)" />
    </svg>
  </div>

  <div class="section-container relative z-10">
    <!-- Section Header -->
    <div class="mb-6 text-center reveal">
      <h2 class="font-heading text-4xl font-bold text-text-primary">Portfolio</h2>
      <div class="mx-auto mt-4 h-0.5 w-16 bg-neon-yellow"></div>
    </div>

    <p class="mb-12 text-center text-text-muted reveal reveal-delay-1">
      Proyectos seleccionados de diseño editorial
    </p>

    <!-- Filter Buttons -->
    <div class="mb-10 flex flex-wrap justify-center gap-3 reveal reveal-delay-2" id="portfolio-filters">
      {filters.map((filter, i) => (
        <button
          class:list={[
            'portfolio-filter rounded-none px-5 py-2 text-sm font-medium tracking-wide transition-all duration-300 cursor-pointer',
            i === 0
              ? 'bg-neon-yellow text-bg-base'
              : 'border border-border-subtle text-text-muted hover:border-neon-yellow hover:text-neon-yellow',
          ]}
          data-filter={filter}
        >
          {filter}
        </button>
      ))}
    </div>

    <!-- Project Grid -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" id="portfolio-grid">
      {projects.map((project, i) => (
        <article
          class={`portfolio-card group cursor-pointer overflow-hidden rounded-none neon-border bg-bg-elevated transition-all duration-500 reveal reveal-delay-${Math.min(i + 1, 6)}`}
          data-category={project.category}
        >
          <!-- Image Container -->
          <div class="relative aspect-[4/3] overflow-hidden">
            <img
              src={project.image}
              alt={project.title}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              loading="lazy"
            />
            <!-- Hover Overlay -->
            <div class="absolute inset-0 flex flex-col justify-end bg-bg-base/90 p-8 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
              <span class="mb-2 text-xs font-medium uppercase tracking-wider text-neon-blue">
                {project.category}
              </span>
              <h3 class="font-heading text-2xl font-semibold text-text-primary">
                {project.title}
              </h3>
            </div>
          </div>

          <!-- Card Info -->
          <div class="p-8">
            <span class="text-xs font-medium uppercase tracking-wider text-neon-pink">
              {project.category}
            </span>
            <h3 class="mt-2 font-heading text-xl font-semibold text-text-primary">
              {project.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">
              {project.description}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const filtersContainer = document.getElementById('portfolio-filters');
    const grid = document.getElementById('portfolio-grid');
    if (!filtersContainer || !grid) return;

    const buttons = filtersContainer.querySelectorAll<HTMLButtonElement>('.portfolio-filter');
    const cards = grid.querySelectorAll<HTMLElement>('.portfolio-card');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;

        // Update active button styles
        buttons.forEach((b) => {
          b.classList.remove('bg-neon-yellow', 'text-bg-base');
          b.classList.add('border', 'border-border-subtle', 'text-text-muted', 'hover:border-neon-yellow', 'hover:text-neon-yellow');
        });
        btn.classList.add('bg-neon-yellow', 'text-bg-base');
        btn.classList.remove('border', 'border-border-subtle', 'text-text-muted', 'hover:border-neon-yellow', 'hover:text-neon-yellow');

        // Filter cards
        cards.forEach((card, index) => {
          const category = card.dataset.category;
          const isVisible = filter === 'Todos' || category === filter;

          if (isVisible) {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            card.style.display = '';

            // Staggered reveal
            requestAnimationFrame(() => {
              setTimeout(() => {
                card.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
              }, index * 80);
            });
          } else {
            card.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
            card.style.opacity = '0';
            card.style.transform = 'translateY(10px)';
            setTimeout(() => {
              card.style.display = 'none';
            }, 300);
          }
        });
      });
    });
  });
</script>
