---
const socialLinks = [
  {
    name: 'Instagram',
    href: 'https://instagram.com/mrtxstudio',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
    </svg>`,
  },
  {
    name: 'Behance',
    href: 'https://behance.net/mrtxstudio',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M1 12s3-7 5-7h4c2 0 3 1.5 3 3s-1 3-3 3H6"/>
      <path d="M6 11h5c2 0 3.5 1.5 3.5 3.5S13 18 11 18H6c-2 0-5-7-5-7"/>
      <path d="M16 6h6"/>
      <path d="M22 12c0-2-1.5-4-4-4s-4 2-4 4 1.5 4 4 4c1.5 0 2.7-.7 3.4-1.8"/>
    </svg>`,
  },
  {
    name: 'LinkedIn',
    href: 'https://linkedin.com/in/martadorado',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
      <rect x="2" y="9" width="4" height="12"/>
      <circle cx="4" cy="4" r="2"/>
    </svg>`,
  },
];
---

<footer class="bg-bg-base border-t border-border-subtle py-8">
  <div class="section-container">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <!-- Left: Copyright -->
      <p class="text-text-muted text-sm">
        © 2026 mrtx studio — Marta Dorado
      </p>

      <!-- Center: Tagline -->
      <p class="text-text-muted text-sm flex items-center gap-1.5">
        Diseñado con pasión y
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-neon-pink" stroke="none">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        neón
      </p>

      <!-- Right: Social Icons -->
      <div class="flex items-center gap-4">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={link.name}
            class="text-text-muted hover:text-neon-pink transition"
          >
            <span set:html={link.icon} />
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
