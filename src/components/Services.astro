---
const services = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
      <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
    </svg>`,
    title: 'Diseño Editorial',
    description: 'Maquetación profesional de revistas, libros, catálogos y publicaciones periódicas. Cada página diseñada para guiar la lectura y emocionar al lector.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/>
      <circle cx="12" cy="12" r="3"/>
    </svg>`,
    title: 'Dirección de Arte',
    description: 'Conceptualización visual completa para proyectos editoriales. Defino la narrativa gráfica, paleta cromática y estilo fotográfico de cada publicación.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="4 7 4 4 20 4 20 7"/>
      <line x1="9" y1="20" x2="15" y2="20"/>
      <line x1="12" y1="4" x2="12" y2="20"/>
    </svg>`,
    title: 'Identidad de Publicación',
    description: 'Creación de sistemas visuales para publicaciones: cabeceras, retículas, paletas tipográficas y guías de estilo que dan personalidad a cada proyecto.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 6 2 18 2 18 9"/>
      <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
      <rect x="6" y="14" width="12" height="8"/>
    </svg>`,
    title: 'Producción Print & Digital',
    description: 'Preparación de archivos para imprenta offset y digital, así como adaptación a formatos interactivos para tablets y publicaciones web.',
  },
];
---

<section id="services" class="section-padding relative overflow-hidden">
  <!-- Decorative organic shapes -->
  <div class="pointer-events-none absolute inset-0 opacity-5" aria-hidden="true">
    <svg class="absolute top-10 -left-12 w-80 h-80 text-neon-pink animate-float-reverse" viewBox="0 0 100 100" fill="currentColor">
      <path d="M30,-40C43,-35,53,-23,60,-8C67,7,71,25,65,39C59,53,43,63,27,68C11,73,-5,73,-21,68Z" transform="translate(50,50)" />
    </svg>
  </div>

  <div class="section-container relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16 reveal">
      <h2 class="text-4xl md:text-5xl font-heading font-bold text-text-primary mb-4">
        Servicios
      </h2>
      <div class="w-16 h-0.5 bg-neon-pink mx-auto mb-6"></div>
      <p class="text-text-muted text-lg max-w-xl mx-auto">
        Soluciones editoriales de principio a fin
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {services.map((service, index) => (
        <div
          class={`p-8 rounded-2xl neon-border bg-bg-elevated/50 hover:bg-bg-elevated transition-all duration-300 reveal reveal-delay-${index + 1}`}
        >
          <div class="text-neon-blue" set:html={service.icon} />
          <h3 class="text-xl font-heading font-semibold mt-4 mb-3">
            {service.title}
          </h3>
          <p class="text-text-muted text-sm leading-relaxed">
            {service.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
